diff --git a/src/data/projects.js b/src/data/projects.js
new file mode 100644
index 0000000..1fa3749
--- /dev/null
+++ b/src/data/projects.js
@@ -0,0 +1,19 @@
+const KEY = "projects";
+
+export function loadProjects() {
+  const raw = localStorage.getItem(KEY);
+  return raw ? JSON.parse(raw) : [];
+}
+
+function makeId() {
+  return "proj-" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
+}
+
+// answers: { comfort, days, depth } from the wizard
+export function createProject({ title, domainId, comfort, days, depth }) {
+  const project = { id: makeId(), title, domainId, comfort, days, depth };
+  const projects = loadProjects();
+  projects.push(project);
+  localStorage.setItem(KEY, JSON.stringify(projects));
+  return project;
+}
